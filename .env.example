# Ads Site Configuration

# 서버 포트
PORT=3100

# 원본 광고 API 주소
SOURCE_API_URL=https://marblerouletteshop.com/api/ads/active

# 다운로드한 이미지를 저장할 로컬 디렉토리 경로
STORAGE_DIR=./creative

# 변환된 광고 JSON 데이터를 저장할 파일 경로
OUTPUT_API_FILE=./api/ads/active

# 변환된 JSON 내에서 이미지 URL의 접두사 (상대 경로 또는 CDN/도메인)
IMAGE_PUBLIC_PREFIX=/creative

# 동기화 주기 (시간 단위 또는 크론 표현식)
SYNC_INTERVAL_HOURS=6
SYNC_CRON=0 */6 * * *

# 서버 시작 시 즉시 초기 동기화 실행 여부 (true/false)
AUTO_SYNC_ON_START=true
